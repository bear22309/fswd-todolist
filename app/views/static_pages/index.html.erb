<!-- static_pages/index.html -->
<%= javascript_pack_tag 'index', 'data-turbolinks-track': 'reload' %>

<div class="container">
  <div class="row">
    <div class="col-12">
      <h1 class="text-center mt-4">To Do List</h1>

      <!-- Task input and list elements -->
      <div class="task-input mb-3">
        <input type="text" id="taskTitle" class="form-control" placeholder="Add a new task...">
        <button id="addTaskButton" class="btn btn-primary mt-2">Add Task</button>
      </div>

      <div id="tasks-list" class="mt-4">
        <!-- Tasks will be dynamically loaded here -->
      </div>
    </div>
  </div>
</div>

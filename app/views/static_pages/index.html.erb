<div class="container">
  <div class="row">
    <div class="col-12">
      <h1 class="text-center mt-4">To Do List</h1>

      <!-- Add your task input and list elements here -->
      <div class="task-input mb-3">
        <input type="text" id="taskTitle" class="form-control" placeholder="Add a new task title...">
        <input type="text" id="taskDescription" class="form-control mt-2" placeholder="Add a description...">
        <button id="addTaskButton" class="btn btn-primary mt-2">Add Task</button>
      </div>

      <ul id="tasks-list" class="mt-4">
        <!-- Tasks will be dynamically loaded here -->
      </ul>
    </div>
  </div>
</div>